<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SemilleroGR3.Views.LoginView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView VerticalOptions="FillAndExpand">
        <VerticalStackLayout Spacing="25" Padding="40,60,40,40" VerticalOptions="Center">



            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                <Label Text="Bienvenido" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       TextColor="#333333" />
                

                <Border HeightRequest="100" 
                        WidthRequest="100" 
                        HorizontalOptions="Center"
                        Margin="0,15,0,5"
                        StrokeShape="RoundRectangle 50"
                        StrokeThickness="2"
                        Stroke="#66BB6A"
                        BackgroundColor="#F0F0F0">
                    <Image Source="usuario.png" 
                           Aspect="AspectFill" />
                </Border>

                <Label Text="Inicia sesión para continuar" 
                       FontSize="16" 
                       HorizontalOptions="Center" 
                       TextColor="#757575" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15">
                <Frame CornerRadius="12" HasShadow="False" BorderColor="#E0E0E0" Padding="5,0">
                    <Entry Text="{Binding Email}" 
                           Placeholder="Correo electrónico" 
                           Keyboard="Email" 
                           HeightRequest="50"/>
                </Frame>

                <Frame CornerRadius="12" HasShadow="False" BorderColor="#E0E0E0" Padding="5,0">
                    <Entry Text="{Binding Password}" 
                           Placeholder="Contraseña" 
                           IsPassword="True" 
                           HeightRequest="50"/>
                </Frame>
            </VerticalStackLayout>

            <Label Text="{Binding MensajeError}" 
                   TextColor="#D32F2F" 
                   HorizontalOptions="Center"
                   FontSize="14"
                   IsVisible="{Binding MensajeError, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"/>

            <Button Text="INGRESAR" 
                    Command="{Binding LoginCommand}" 
                    CornerRadius="12" 
                    BackgroundColor="#66BB6A" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="55"
                    Margin="0,10,0,0">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.15" />
                </Button.Shadow>
            </Button>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               HorizontalOptions="Center" 
                               Color="#66BB6A"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>