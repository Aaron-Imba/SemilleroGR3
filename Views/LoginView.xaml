<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SemilleroGR3.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SemilleroGR3.Views.LoginView"
             Title="Iniciar Sesión"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

            <Image Source="pinguino_tejido.png" 
                   HeightRequest="150" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20"/>

            <Label Text="Sistema Familia" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Border StrokeThickness="1" Stroke="LightGray">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Entry Text="{Binding Email}" 
                       Placeholder="Correo electrónico" 
                       Keyboard="Email" 
                       Margin="10,5"/>
            </Border>

            <Border StrokeThickness="1" Stroke="LightGray">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Entry Text="{Binding Password}" 
                       Placeholder="Contraseña" 
                       IsPassword="True" 
                       Margin="10,5"/>
            </Border>

            <Label Text="{Binding MensajeError}" 
                   TextColor="Red" 
                   HorizontalOptions="Center" 
                   IsVisible="{Binding MensajeError, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"/>

            <Button Text="INGRESAR" 
                    Command="{Binding LoginCommand}" 
                    CornerRadius="20" 
                    BackgroundColor="#2196F3" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    HeightRequest="50"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               HorizontalOptions="Center" 
                               Color="#2196F3"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>