<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SemilleroGR3.ViewModels"
             x:Class="SemilleroGR3.Views.DashboardView"
             Title="Dashboard Familia">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Selecciona el perfil de tu hijo/a:" 
               FontSize="16" 
               TextColor="Gray" />

        <Frame CornerRadius="10" BorderColor="#2196F3" Padding="5">
            <Picker ItemsSource="{Binding Hijos}" 
                    ItemDisplayBinding="{Binding NombreCompleto}"
                    SelectedItem="{Binding HijoSeleccionado}"
                    Title="Toca para seleccionar..."
                    FontSize="18"
                    FontAttributes="Bold"/>
        </Frame>

        <Label Text="Navega usando el menú inferior para ver el seguimiento, historial y tareas."
               FontSize="14"
               HorizontalTextAlignment="Center"
               Margin="0,20,0,0"
               TextColor="Gray"/>

    </VerticalStackLayout>
</ContentPage>