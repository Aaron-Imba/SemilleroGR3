<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SemilleroGR3.Views.PerfilHijoView"
             Title="Perfil del Alumno">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Frame CornerRadius="15" BackgroundColor="#E3F2FD" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nombre del Estudiante" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding NombreCompleto}" FontSize="22" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="15" BackgroundColor="#F5F5F5" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Fecha de Nacimiento" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding FechaNacimientoTexto}" FontSize="18"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="15" BackgroundColor="#F5F5F5" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Grupo Asignado" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding GrupoAsignado}" FontSize="18"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="15" BackgroundColor="#F5F5F5" BorderColor="Transparent">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Docente Responsable" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding DocenteResponsable}" FontSize="18"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>