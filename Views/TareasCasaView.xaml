<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SemilleroGR3.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SemilleroGR3.Views.TareasCasaView"
             Title="Actividades en Casa">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <CollectionView ItemsSource="{Binding Tareas}" Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeThickness="1" 
                        Stroke="#E0E0E0" 
                        Margin="5,10" 
                        BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10" Padding="15">
                        <Label Text="{Binding TituloActividad}" FontAttributes="Bold" FontSize="18"/>
                        <Label Text="{Binding DescripcionActividad}" FontSize="14" TextColor="DarkGray"/>

                        <Grid ColumnDefinitions="Auto, *" Margin="0,10,0,0">
                            <CheckBox Grid.Column="0" IsChecked="{Binding Realizada}" Color="#2196F3"/>
                            <Label Grid.Column="1" Text="Marcar como completada" VerticalOptions="Center"/>
                        </Grid>

                        <Entry Placeholder="Añadir comentario breve..." 
                               Text="{Binding ComentarioBreve, Mode=TwoWay}" 
                               IsEnabled="{Binding Realizada, Converter={StaticResource InvertedBoolConverter}}"
                               IsVisible="{Binding Realizada, Converter={StaticResource InvertedBoolConverter}}"/>

                        <Button Text="ENVIAR REPORTE"
                                Clicked="OnEnviarReporteClicked"
                                CornerRadius="8"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                IsEnabled="{Binding Realizada, Converter={StaticResource InvertedBoolConverter}}"
                                IsVisible="{Binding Realizada, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>