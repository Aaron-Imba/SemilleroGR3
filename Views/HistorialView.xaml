<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SemilleroGR3.Views.HistorialView"
             Title="Historial">

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center"/>

        <CollectionView ItemsSource="{Binding HistorialEvaluaciones}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="8" Margin="0,5" BorderColor="#B0BEC5" BackgroundColor="#ECEFF1">
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" Padding="10">
                            <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="📅" FontSize="30" VerticalOptions="Center" Margin="0,0,15,0"/>

                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding FechaEvaluacion, StringFormat='{0:dd MMM yyyy}'}" FontAttributes="Bold" FontSize="16"/>
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding NotaGeneral}" FontSize="14" TextColor="#546E7A"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>