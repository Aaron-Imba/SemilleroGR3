<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SemilleroGR3.ViewModels"
             xmlns:models="clr-namespace:SemilleroGR3.Models"
             x:Class="SemilleroGR3.Views.HistorialView"
             x:DataType="vm:HistorialViewModel"
             Title="Historial de Avance"
             BackgroundColor="#F5F7FF">

    <Grid>

        <!-- ══════════ CONTENIDO PRINCIPAL ══════════ -->
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- ── HEADER AZUL ────────────────────────────────────── -->
                <Border BackgroundColor="#4b9839" StrokeThickness="0" Padding="18,22,18,26">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,20,20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Historial de Avance" FontSize="20" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="Progreso cognitivo por período" FontSize="12"
                               TextColor="#C5CAE9" HorizontalOptions="Center"/>

                        <!-- Tarjetas resumen -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
                            <Border Grid.Column="0" BackgroundColor="#b9b9b9"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding TotalEvaluaciones}" FontSize="24"
                                           FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="Evaluaciones" FontSize="10"
                                           TextColor="white" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#b9b9b9"
                                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding NivelGeneral}" FontSize="15"
                                           FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                    <Label Text="Nivel General" FontSize="10"
                                           TextColor="White" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── GRÁFICO DE TENDENCIA ───────────────────────────── -->
                <VerticalStackLayout Padding="14,16,14,0" Spacing="10">
                    <Label Text="TENDENCIA POR PERÍODO" FontSize="11" FontAttributes="Bold"
                           TextColor="#616161" CharacterSpacing="1"/>

                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                            Stroke="#E0E4FF" StrokeThickness="1" Padding="14">
                        <VerticalStackLayout Spacing="12">

                            <!-- Leyenda -->
                            <FlexLayout Wrap="Wrap" JustifyContent="Start" >
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="#B71C1C" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                                    <Label Text="Iniciado" FontSize="11" TextColor="#424242"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="#E65100" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                                    <Label Text="En Proceso" FontSize="11" TextColor="#424242"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="#1565C0" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                                    <Label Text="Logrado" FontSize="11" TextColor="#424242"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <BoxView Color="#2E7D32" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                                    <Label Text="Destacado" FontSize="11" TextColor="#424242"/>
                                </HorizontalStackLayout>
                            </FlexLayout>

                            <!-- Barras con BindableLayout -->
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tendencia}"
                                                   HorizontalOptions="Center" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BarraProgreso">
                                        <VerticalStackLayout WidthRequest="44" HorizontalOptions="Center" Spacing="4">
                                            <Label Text="{Binding ValorTexto}" FontSize="11" FontAttributes="Bold"
                                                   TextColor="#424242" HorizontalOptions="Center"/>
                                            <BoxView Color="{Binding Color}" HeightRequest="{Binding Altura}"
                                                     CornerRadius="4,4,0,0" HorizontalOptions="Center"
                                                     WidthRequest="32"/>
                                            <Label Text="{Binding Etiqueta}" FontSize="10" TextColor="#616161"
                                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ── EVALUACIONES AGRUPADAS POR FECHA ──────────────── -->
                <VerticalStackLayout Padding="14,16,14,0" Spacing="8">
                    <Label Text="EVALUACIONES POR PERÍODO" FontSize="11" FontAttributes="Bold"
                           TextColor="#616161" CharacterSpacing="1"/>
                </VerticalStackLayout>

                <!-- CollectionView con lazy loading (RNF-04) -->
                <CollectionView ItemsSource="{Binding Periodos}"
                                SelectionMode="None"
                                Margin="14,8,14,0"
                                RemainingItemsThreshold="1"
                                RemainingItemsThresholdReachedCommand="{Binding CargarMasCommand}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GrupoFecha">

                            <!-- Tarjeta por período -->
                            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12"
                                    Stroke="#E0E4FF" StrokeThickness="1" Padding="14" Margin="0,0,0,12">
                                <Border.Shadow>
                                    <Shadow Brush="#1A3949AB" Radius="6" Offset="0,2"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">

                                    <!-- Cabecera período -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding FechaTexto}" FontSize="15"
                                                   FontAttributes="Bold" TextColor="#1A237E"/>
                                            <Label FontSize="12" TextColor="#9E9E9E">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TotalCriterios}"/>
                                                        <Span Text=" criterios evaluados"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- Chip nivel promedio -->
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 20"
                                                StrokeThickness="0" BackgroundColor="{Binding ColorPromedio}"
                                                Padding="10,5">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding PromedioFormateado}" FontSize="13"
                                                       FontAttributes="Bold" TextColor="White"/>
                                                <Label Text="{Binding TextoPromedio}" FontSize="11"
                                                       TextColor="White"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Separador -->
                                    <BoxView HeightRequest="1" Color="#F0F0F0" HorizontalOptions="Fill"/>

                                    <!-- Criterios de cada evaluación -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Evaluaciones}"
                                                         Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:Evaluacion">

                                                <!-- Nota general de la evaluación -->
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding NotaGeneral}" FontSize="13"
                                                           TextColor="#546E7A" FontAttributes="Italic"/>

                                                    <!-- Detalles por criterio -->
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detalles}"
                                                                         Spacing="6">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DetalleEvaluacion">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                                                    <!-- Criterio y observación -->
                                                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                                        <Label Text="{Binding CriterioNombre}"
                                                                               FontSize="14" FontAttributes="Bold"
                                                                               TextColor="#212121"/>
                                                                        <Label Text="{Binding ObservacionEspecifica}"
                                                                               FontSize="12" TextColor="#9E9E9E"/>
                                                                    </VerticalStackLayout>

                                                                    <!-- Chip del nivel (sin terminología técnica) -->
                                                                    <Border Grid.Column="1"
                                                                            StrokeShape="RoundRectangle 16"
                                                                            StrokeThickness="0"
                                                                            Padding="8,4"
                                                                            BackgroundColor="#E8EAF6"
                                                                            VerticalOptions="Center">
                                                                        <Label Text="{Binding NivelNombre}"
                                                                               FontSize="12" FontAttributes="Bold"
                                                                               TextColor="#3949AB"
                                                                               HorizontalOptions="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>

                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Footer: spinner y botón de más -->
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,4,0,24" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                              IsVisible="{Binding IsLoadingMore}"
                                              Color="#3949AB" HorizontalOptions="Center"/>
                            <Label Text="✓ Todo el historial cargado"
                                   IsVisible="{Binding HayMas, Converter={StaticResource InvertedBoolConverter}}"
                                   FontSize="12" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.Footer>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ OVERLAY carga inicial ══ -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#F5F7FF">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="#3949AB" WidthRequest="48" HeightRequest="48"/>
                <Label Text="Cargando historial..." TextColor="#616161" FontSize="14" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ══ OVERLAY error ══ -->
        <Grid IsVisible="{Binding HayError}" BackgroundColor="#F5F7FF" Padding="32">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <Label Text="📭" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="{Binding MensajeError}" TextColor="#616161" FontSize="15"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
