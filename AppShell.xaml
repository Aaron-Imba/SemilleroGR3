<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SemilleroGR3.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SemilleroGR3"
    xmlns:views="clr-namespace:SemilleroGR3.Views"
    Title="SemilleroGR3">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginView}"
        Route="Login"
        Shell.NavBarIsVisible="False"
        Shell.FlyoutItemIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <TabBar Route="Dashboard">

        <!--<Tab Title="Seguimiento" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:SeguimientoView}" />
        </Tab>-->

        <Tab Title="Inicio" Icon="icon_home.png">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardView}" />
        </Tab>

        <Tab Title="Historial" Icon="icon_history.png">
            <ShellContent ContentTemplate="{DataTemplate views:HistorialView}" />
        </Tab>

        <Tab Title="Tareas" Icon="icon_tasks.png">
            <ShellContent ContentTemplate="{DataTemplate views:TareasCasaView}" />
        </Tab>

        <Tab Title="Progreso" Icon="icon_progress.png" Route="ProgresoView">
            <ShellContent ContentTemplate="{DataTemplate views:ProgresoView}" />
        </Tab>


    </TabBar>

</Shell>